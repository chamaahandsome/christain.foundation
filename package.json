{
  "name": "christian-foundation",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:trickl-webhook": "node scripts/test-trickl-webhook.mjs",
    "load:smoke": "k6 run -e PROFILE=smoke tests/load/cf-load.js",
    "load:baseline": "k6 run -e PROFILE=baseline tests/load/cf-load.js",
    "load:spike": "k6 run -e PROFILE=spike tests/load/cf-load.js",
    "load:stress": "k6 run -e PROFILE=stress tests/load/cf-load.js",
    "load:soak": "k6 run -e PROFILE=soak tests/load/cf-load.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/client-ses": "^3.1126.0",
    "@aws-sdk/client-sesv2": "^3.1126.0",
    "@clerk/nextjs": "^6.12.0",
    "@prisma/client": "^6.5.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extension-youtube": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.1",
    "next": "^15.2.0",
    "pdf2json": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.2.3",
    "stripe": "^22.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
