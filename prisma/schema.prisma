// Christian Foundation — milestone 1 schema
// Concept note §4 (spine and map), §5 (creator gate), PLAN.md §6.
// MySQL + relationMode "prisma" (PlanetScale-style, no DB-level FKs) — every
// relation scalar needs its own @@index.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ---------- identity ----------

model User {
  id        String   @id // Clerk user id
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels        Channel[]
  follows         Follow[]
  watchProgress   WatchProgress[]
  likes           Like[]
  comments        Comment[]
  pathwayProgress PathwayProgress[]
  applications    CreatorApplication[]
  affirmations    AffirmationRecord[]
  notifications   Notification[]
  teamMemberships TeamMember[]
  transactions    Transaction[]
  ebookPurchases  EbookPurchase[]
}

enum NotificationType {
  NEW_CONTENT
  APPLICATION_DECIDED
  VOUCH_RECEIVED
  TEAM_INVITE
  DOCTRINE_CASE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String?          @db.Text
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum ChannelKind {
  TEACHER
  PASTOR
  MISSIONARY
  MUSICIAN
  FILMMAKER
  AUTHOR
  PODCASTER
  ORGANIZER
  RESEARCHER
  ARCHAEOLOGIST
  MINISTRY
}

enum ChannelStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model Channel {
  id                     String        @id @default(cuid())
  handle                 String        @unique // /@handle
  name                   String
  kind                   ChannelKind
  status                 ChannelStatus @default(PENDING)
  bio                    String?       @db.Text
  links                  Json?
  avatarUrl              String?       @db.Text // profile picture (S3)
  bannerUrl              String?       @db.Text // page header image (S3)
  youtubeChannelId       String?       @unique
  // Ownership proof for the linked YouTube channel. Two paths: "google"
  // (Clerk Google OAuth token → channels?mine=true match) or "description"
  // (one-time token pasted into the channel description, read back via the
  // Data API). Importing requires it (admins excepted). Reset on relink.
  youtubeVerifyToken     String?
  youtubeVerifiedAt      DateTime?
  youtubeVerifiedVia     String? // "google" | "description"
  // Stripe Connect (Express) — commerce spine (PLAN §10 phase 6). A channel
  // that can't be paid out must not publish revenue surfaces (§9.4).
  stripeAccountId        String?       @unique
  stripeChargesEnabled   Boolean       @default(false)
  stripePayoutsEnabled   Boolean       @default(false)
  stripeOnboardedAt      DateTime?
  // Trickl micro-payments (api.trickl.app): provider registration rides the
  // channel's Stripe Connect account. Chunks are destination charges into
  // CF's partner Stripe balance (Trickl can't pay accounts on CF's
  // platform); CF forwards the net per chunk — see TricklChunk. Webhook
  // secret is per-provider HMAC.
  tricklProviderLinkCode String?       @unique
  tricklWebhookSecret    String?
  tricklEnabledAt        DateTime?
  ownerId                String
  owner                  User          @relation(fields: [ownerId], references: [id])
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  contentItems ContentItem[]
  series       Series[]
  followers    Follow[]
  vouchesGiven Vouch[]
  reviewCases  DoctrineReviewCase[]
  teamMembers  TeamMember[]
  transactions Transaction[]
  ebooks       Ebook[]
  campaigns    Campaign[]

  @@index([ownerId])
  @@index([status])
}

// ---------- team access (PLAN §4: ministry staff manage a teacher's channel) ----------
// Ported from Maltivas TeamMember/TeamInvitation, folded into one model: a
// PENDING row carries the invite token; accepting binds the Clerk user and
// activates it. Access is per-feature (lib/team.ts), not a single role.

enum TeamMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model TeamMember {
  id              String           @id @default(cuid())
  channelId       String
  channel         Channel          @relation(fields: [channelId], references: [id])
  email           String
  userId          String? // null until the invitation is accepted
  user            User?            @relation(fields: [userId], references: [id])
  // Per-feature access map, e.g. { "library": "manager", "team": "none" } —
  // parsed and enforced by lib/team.ts. JSON so ported Maltivas features can
  // slot in without migrations.
  featureAccess   Json             @default("{}")
  status          TeamMemberStatus @default(PENDING)
  inviteToken     String?          @unique
  inviteExpiresAt DateTime?
  invitedById     String // Clerk user id of the inviter
  invitedAt       DateTime         @default(now())
  acceptedAt      DateTime?
  updatedAt       DateTime         @updatedAt

  @@unique([channelId, email])
  @@index([channelId])
  @@index([userId])
  @@index([email])
  @@index([status])
}

// Founding-cohort invitations (lib/gate.ts: invited applications bypass the
// vouch minimum). Codes are minted by admins; redemption attaches the code to
// the application so review can see how the applicant arrived.
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String? // who/what this was minted for (admin-facing)
  email       String? // intended recipient, informational
  createdById String // admin Clerk user id
  maxUses     Int       @default(1)
  usageCount  Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  applications CreatorApplication[]
}

// ---------- the creator gate (concept §5) ----------
// Anyone can watch. Not anyone can publish. Vetting is by affirmation, not
// affiliation: the published, versioned doctrinal statement is affirmed
// per-clause, vouched for by existing creators, and audited against the
// published body of work (§5.4) — never by interrogating church membership.

model StatementVersion {
  id          String    @id @default(cuid())
  version     Int       @unique
  title       String
  preamble    String    @db.Text
  publishedAt DateTime?

  clauses      StatementClause[]
  affirmations AffirmationRecord[]
}

model StatementClause {
  id                 String           @id @default(cuid())
  statementVersionId String
  statementVersion   StatementVersion @relation(fields: [statementVersionId], references: [id])
  key                String // e.g. "nicene-creed" — stable across versions
  title              String
  text               String           @db.Text
  sortOrder          Int

  affirmations AffirmationRecord[]

  @@unique([statementVersionId, key])
  @@index([statementVersionId])
}

// One row per clause per affirmation — §5.1: recorded in its plain, historic
// sense, with timestamp and statement version. Never deleted; a re-affirmation
// on a new statement version creates new rows.
model AffirmationRecord {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  statementVersionId String
  statementVersion   StatementVersion @relation(fields: [statementVersionId], references: [id])
  clauseId           String
  clause             StatementClause  @relation(fields: [clauseId], references: [id])
  affirmedAt         DateTime         @default(now())

  @@unique([userId, clauseId])
  @@index([userId])
  @@index([statementVersionId])
  @@index([clauseId])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model CreatorApplication {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  status            ApplicationStatus @default(DRAFT)
  // proposed channel
  proposedHandle    String
  proposedName      String
  proposedKind      ChannelKind
  // Where reviewers verify the applicant's teaching — at least one is
  // required to apply (any platform; YouTube also feeds library ingestion).
  youtubeChannelId  String?
  instagramHandle   String?
  tiktokHandle      String?
  xHandle           String?
  ministryStatement String            @db.Text // who they are, what they teach
  conductAgreedAt   DateTime? // §5.3 conduct standard, standing obligation
  inviteCodeId      String? // founding-cohort invitation, if redeemed
  inviteCode        InviteCode?       @relation(fields: [inviteCodeId], references: [id])
  submittedAt       DateTime?
  decidedAt         DateTime?
  decidedById       String? // admin user id
  decisionNote      String?           @db.Text
  createdChannelId  String? // set on approval
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  vouches Vouch[]

  @@index([userId])
  @@index([status])
  @@index([inviteCodeId])
}

// §5.3: existing creators vouch for new applicants. Trust compounds; it
// doesn't scale by committee.
model Vouch {
  id               String             @id @default(cuid())
  applicationId    String
  application      CreatorApplication @relation(fields: [applicationId], references: [id])
  voucherChannelId String
  voucherChannel   Channel            @relation(fields: [voucherChannelId], references: [id])
  note             String?            @db.Text
  createdAt        DateTime           @default(now())

  @@unique([applicationId, voucherChannelId])
  @@index([applicationId])
  @@index([voucherChannelId])
}

// §5.4: the signature is the gate; the body of work is the audit. Review is
// on published teaching, not paperwork. Distinct from safety moderation.
enum ReviewCaseStatus {
  OPEN
  IN_REVIEW
  UPHELD // the standard was violated
  DISMISSED
  APPEALED
}

model DoctrineReviewCase {
  id            String           @id @default(cuid())
  channelId     String
  channel       Channel          @relation(fields: [channelId], references: [id])
  contentItemId String? // the published teaching cited
  contentItem   ContentItem?     @relation(fields: [contentItemId], references: [id])
  claim         String           @db.Text // what standard is alleged violated, citing content
  status        ReviewCaseStatus @default(OPEN)
  openedById    String? // user id; null = editorial
  reviewerId    String?
  outcomeNote   String?          @db.Text
  decidedAt     DateTime?
  appealNote    String?          @db.Text // the channel's appeal (UPHELD → APPEALED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([channelId])
  @@index([contentItemId])
  @@index([status])
}

model Follow {
  userId    String
  channelId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  channel   Channel  @relation(fields: [channelId], references: [id])

  @@id([userId, channelId])
  @@index([channelId])
  @@index([userId])
}

// ---------- ledger (commerce spine, PLAN §10 phase 6) ----------
// Every money movement gets a Transaction row; webhooks are processed
// exactly once via ProcessedWebhookEvent. Partner gifts (phase 7) use
// direct charges on the connected account — the recipient is merchant of
// record, never CF (§9).

enum TransactionType {
  PURCHASE // commerce: ebooks, products, films
  TICKET
  GIFT // partner giving (phase 7)
  PLEDGE // crowdfunding (concept §7b)
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Trickl partner distribution: chunks land in CF's Stripe balance (Trickl
// cannot pay creators onboarded on CF's platform), and CF forwards the net
// onward, keeping its fee. One row per movement of money, keyed on Trickl's
// chunkId — the idempotency key across webhook deliveries and reversals.
enum TricklChunkStatus {
  RECEIVED // chunk landed in CF's balance, not yet forwarded
  FORWARDED // net transferred to the creator's connected account
  FORWARD_FAILED // transfer failed (usually balance timing) — cron retries
  REVERSED // Trickl clawed the chunk back (ACH return / dispute)
}

model TricklChunk {
  id         String            @id @default(cuid())
  chunkId    String            @unique // Trickl's per-money-movement id
  goalId     String
  channelId  String
  kind       String // round_up | deposit | cycle
  cfKind     String // tip | ebook | …
  grossCents Int // what landed in CF's balance (post-Trickl-fee gross)
  feeCents   Int // CF's cut, kept on forwarding
  netCents   Int // forwarded to the creator
  status     TricklChunkStatus @default(RECEIVED)
  transferId String? // CF's onward Stripe transfer id
  lastError  String?           @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([channelId])
  @@index([goalId])
  @@index([status])
}

model Transaction {
  id          String            @id @default(cuid())
  channelId   String
  channel     Channel           @relation(fields: [channelId], references: [id])
  userId      String?
  user        User?             @relation(fields: [userId], references: [id])
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amountCents Int
  feeCents    Int               @default(0) // CF's application fee
  currency    String            @default("usd")
  provider    String            @default("stripe")
  providerRef String?           @unique // payment intent / charge id
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([channelId])
  @@index([userId])
  @@index([status])
}

// Webhooks are at-least-once; this makes processing exactly-once.
model ProcessedWebhookEvent {
  id          String   @id // provider event id
  provider    String
  processedAt DateTime @default(now())
}

// ---------- ebooks (first purchasable, PLAN §10 phase 6) ----------
// Chapter HTML lives in the database (the Maltivas model) — the reader
// streams protected markup, never a downloadable file. Purchase is
// book-level and grants all chapters.

model Ebook {
  id            String   @id @default(cuid())
  channelId     String
  channel       Channel  @relation(fields: [channelId], references: [id])
  title         String
  author        String?
  description   String?  @db.Text
  coverImageUrl String?  @db.Text
  priceCents    Int      @default(0) // 0 = free
  currency      String   @default("usd")
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chapters  EbookChapter[]
  purchases EbookPurchase[]

  @@index([channelId, published])
}

model EbookChapter {
  id          String  @id @default(cuid())
  ebookId     String
  ebook       Ebook   @relation(fields: [ebookId], references: [id])
  sortOrder   Int
  title       String
  htmlContent String? @db.LongText
  freePreview Boolean @default(false) // readable before purchase

  @@unique([ebookId, sortOrder])
  @@index([ebookId])
}

model EbookPurchase {
  id            String   @id @default(cuid())
  ebookId       String
  ebook         Ebook    @relation(fields: [ebookId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  provider      String // "stripe" | "trickl" | "free"
  transactionId String? // ledger row backing this grant
  createdAt     DateTime @default(now())

  @@unique([userId, ebookId])
  @@index([ebookId])
  @@index([userId])
}

// ---------- content ----------

enum ContentSource {
  EMBEDDED_YOUTUBE
  NATIVE_MUX
  DOCUMENT
}

enum ContentKind {
  VIDEO
  SERMON
  MUSIC
  PODCAST
  FILM
  PAPER
  DATASET
}

enum Visibility {
  PUBLIC
  MEMBERS
  PAID
}

// YouTube-shaped presentation format: Shorts and archived live streams get
// their own shelves, mirroring how the channel looks on YouTube.
enum ContentFormat {
  STANDARD
  SHORT
  LIVE
}

model Series {
  id                String   @id @default(cuid())
  channelId         String
  channel           Channel  @relation(fields: [channelId], references: [id])
  title             String
  description       String?  @db.Text
  // Set when the series mirrors a YouTube playlist (ingest keeps it synced);
  // null for hand-made series.
  youtubePlaylistId String?  @unique
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contentItems ContentItem[]

  @@index([channelId])
}

model ContentItem {
  id             String        @id @default(cuid())
  channelId      String
  channel        Channel       @relation(fields: [channelId], references: [id])
  seriesId       String?
  series         Series?       @relation(fields: [seriesId], references: [id])
  source         ContentSource
  kind           ContentKind
  title          String
  description    String?       @db.Text
  // EMBEDDED_YOUTUBE
  youtubeVideoId String?
  // NATIVE_MUX
  muxAssetId     String?
  muxPlaybackId  String?
  // DOCUMENT
  fileKey        String?
  audioOnly      Boolean       @default(false)
  durationSec    Int?
  format         ContentFormat @default(STANDARD)
  visibility     Visibility    @default(PUBLIC)
  scriptureRefs  Json? // normalized refs, see lib/scripture.ts
  searchText     String?       @db.Text // tags now; transcripts once owner-OAuth captions land
  // Set by the dead-embed cron when the source video vanishes from YouTube;
  // public surfaces filter it out, the row stays for the creator to see.
  unavailableAt  DateTime?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  watchProgress WatchProgress[]
  likes         Like[]
  comments      Comment[]
  placements    ContentPlacement[]
  pathwaySteps  PathwayStep[]
  shelfItems    ShelfItem[]
  reviewCases   DoctrineReviewCase[]

  @@unique([channelId, youtubeVideoId])
  @@index([channelId])
  @@index([channelId, format])
  @@index([seriesId])
  @@index([kind])
  @@index([publishedAt])
  // Topical search across metadata + transcript-derived text (PLAN §3).
  @@fulltext([title, description, searchText])
}

model WatchProgress {
  userId        String
  contentItemId String
  positionSec   Int         @default(0)
  completedAt   DateTime?
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id])
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])

  @@id([userId, contentItemId])
  @@index([contentItemId])
  @@index([userId])
}

model Like {
  userId        String
  contentItemId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])

  @@id([userId, contentItemId])
  @@index([contentItemId])
  @@index([userId])
}

enum CommentStatus {
  PENDING
  APPROVED
  HIDDEN
  REMOVED
}

model Comment {
  id            String        @id @default(cuid())
  contentItemId String
  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  parentId      String?
  body          String        @db.Text
  status        CommentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([contentItemId])
  @@index([userId])
  @@index([parentId])
}

// ---------- the doctrinal map (concept §4) ----------

model Topic {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  parentId  String?
  sortOrder Int     @default(0)

  questions  Question[]
  placements ContentPlacement[]

  @@index([parentId])
}

enum QuestionTier {
  SPINE // essentials: one curated path, one confident answer
  DISPUTED // secondary questions: positions presented side by side
}

model Question {
  id        String       @id @default(cuid())
  slug      String       @unique
  title     String
  tier      QuestionTier
  // plain-language explanation of what is at stake and why it matters
  // less than the spine (DISPUTED) / why there is certainty here (SPINE)
  framing   String       @db.Text
  topicId   String?
  topic     Topic?       @relation(fields: [topicId], references: [id])
  sortOrder Int          @default(0)

  positions  Position[]
  placements ContentPlacement[]

  @@index([topicId])
}

model Position {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  slug       String
  name       String
  summary    String   @db.Text
  sortOrder  Int      @default(0)

  placements ContentPlacement[]

  @@unique([questionId, slug])
  @@index([questionId])
}

// Editorial placement of content into the map. Exactly one target
// (topic, question, or position) per row — enforced in application code,
// see lib/map.ts placementTarget().
model ContentPlacement {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  topicId       String?
  topic         Topic?      @relation(fields: [topicId], references: [id])
  questionId    String?
  question      Question?   @relation(fields: [questionId], references: [id])
  positionId    String?
  position      Position?   @relation(fields: [positionId], references: [id])
  note          String?
  createdAt     DateTime    @default(now())

  @@index([contentItemId])
  @@index([topicId])
  @@index([questionId])
  @@index([positionId])
}

// ---------- Start Here pathways (concept §7) ----------

model Pathway {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String? @db.Text
  published   Boolean @default(false)

  steps PathwayStep[]
}

model PathwayStep {
  id            String       @id @default(cuid())
  pathwayId     String
  pathway       Pathway      @relation(fields: [pathwayId], references: [id])
  sortOrder     Int
  title         String
  description   String?      @db.Text
  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id])

  progress PathwayProgress[]

  @@unique([pathwayId, sortOrder])
  @@index([pathwayId])
  @@index([contentItemId])
}

model PathwayProgress {
  userId      String
  stepId      String
  completedAt DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  step        PathwayStep @relation(fields: [stepId], references: [id])

  @@id([userId, stepId])
  @@index([stepId])
  @@index([userId])
}

// ---------- editorial shelves (home/explore rows) ----------

model Shelf {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  sortOrder Int     @default(0)
  published Boolean @default(false)

  items ShelfItem[]
}

model ShelfItem {
  id            String       @id @default(cuid())
  shelfId       String
  shelf         Shelf        @relation(fields: [shelfId], references: [id])
  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id])
  sortOrder     Int          @default(0)

  @@index([shelfId])
  @@index([contentItemId])
}

// ---------- crowdfunding (concept §7b, ported from Maltivas minus DAO) ----------
// Direct-support model: pledges are charged at payment time and routed to
// the creator immediately (MISSION = §9 gift-shaped direct charge on the
// creator's account; CREATIVE = commerce-shaped destination charge with a
// stated deliverable). No funds are ever held; the completion cron only
// flips status when the end date passes. RESEARCH (qualification workflow)
// and NEED (voucher + fraud review) are reserved in the enum, gated off.

enum CampaignCategory {
  MISSION // inherits §9 in full — Mode B disclosure per pledge
  CREATIVE // CF-vetted creator, stated deliverable + timeline
  RESEARCH // ships later — qualification record required
  NEED // ships last — voucher + strictest review
}

enum CampaignStatus {
  DRAFT
  LIVE
  FUNDED // goal met (set live or at completion)
  COMPLETED // ended without meeting goal — pledges already with the creator
  CANCELLED
}

model Campaign {
  id               String           @id @default(cuid())
  channelId        String
  channel          Channel          @relation(fields: [channelId], references: [id])
  category         CampaignCategory
  status           CampaignStatus   @default(DRAFT)
  title            String
  slug             String           @unique
  shortDescription String           @db.Text
  story            String?          @db.Text
  coverImageUrl    String?          @db.Text
  goalCents        Int
  raisedCents      Int              @default(0)
  backersCount     Int              @default(0)
  endsAt           DateTime?
  // CREATIVE campaigns state what backers are funding and when it lands.
  deliverable      String?          @db.Text
  deliveryTimeline String?
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  rewards CampaignReward[]
  pledges CampaignPledge[]
  updates CampaignUpdate[]

  @@index([channelId])
  @@index([status])
  @@index([category])
  @@index([endsAt])
  @@fulltext([title, shortDescription])
}

model CampaignReward {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  title        String
  description  String   @db.Text
  amountCents  Int // minimum pledge to claim this reward
  maxBackers   Int? // null = unlimited
  backersCount Int      @default(0)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pledges CampaignPledge[]

  @@index([campaignId])
}

model CampaignPledge {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id])
  rewardId    String? // null = no-reward pledge
  reward      CampaignReward?   @relation(fields: [rewardId], references: [id])
  userId      String
  amountCents Int
  feeCents    Int               @default(0) // CF's cut, mirrors the Transaction row
  provider    String            @default("stripe") // stripe | trickl
  providerRef String?           @unique // payment intent / trickl goal
  status      TransactionStatus @default(PENDING)
  anonymous   Boolean           @default(false)
  message     String?           @db.Text // word of encouragement, shown to the creator
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([campaignId, status])
  @@index([rewardId])
  @@index([userId])
}

model CampaignUpdate {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  title         String
  body          String   @db.Text
  backersOnly   Boolean  @default(false)
  notifyBackers Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([campaignId, createdAt])
}
