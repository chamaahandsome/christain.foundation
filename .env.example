# Copy to .env and fill in real values.

# MySQL (PlanetScale-style; relationMode is handled by Prisma, not the DB)
DATABASE_URL="mysql://root:password@localhost:3306/christian_foundation"

# Clerk — https://dashboard.clerk.com
# The app boots without these (public pages only); auth-gated routes need them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Signing secret for the user-provisioning webhook (Clerk dashboard →
# Webhooks → endpoint /api/webhook/clerk, events user.created/user.updated)
CLERK_WEBHOOK_SIGNING_SECRET=""

# YouTube Data API v3 — library ingestion (channel import, metadata, captions)
YOUTUBE_API_KEY=""

# Public site origin — sitemap/robots/OG links
NEXT_PUBLIC_SITE_URL="https://christian.foundation"

# Shared secret for Vercel cron endpoints (dead-embed sweep)
CRON_SECRET=""

# Creator gate
# Comma-separated Clerk user ids with admin access (interim, until roles land)
ADMIN_USER_IDS=""
# Comma-separated admin email addresses (matched against verified Clerk emails)
ADMIN_EMAILS=""
# "true" during launch: founding-cohort applications submit without vouches.
# Prefer minting invite codes (/admin/invites) — an application with a
# redeemed code bypasses the vouch minimum on its own; this flag is the
# blanket fallback.
FOUNDING_COHORT_MODE="true"
