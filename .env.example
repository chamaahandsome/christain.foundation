# Copy to .env and fill in real values.

# MySQL (PlanetScale-style; relationMode is handled by Prisma, not the DB)
DATABASE_URL="mysql://root:password@localhost:3306/christian_foundation"

# Clerk — https://dashboard.clerk.com
# The app boots without these (public pages only); auth-gated routes need them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# YouTube Data API v3 — library ingestion (channel import, metadata, captions)
YOUTUBE_API_KEY=""

# Creator gate
# Comma-separated Clerk user ids with admin access (interim, until roles land)
ADMIN_USER_IDS=""
# "true" during launch: founding-cohort applications submit without vouches
FOUNDING_COHORT_MODE="true"
